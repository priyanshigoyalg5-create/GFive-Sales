rules_version = '2';

// GFive Sales — Firestore security rules
// Publish from Firebase Console → Firestore Database → Rules (paste this file),
// or with the Firebase CLI: `firebase deploy --only firestore:rules`.
//
// IMPORTANT: put the Super Admin e-mail(s) in superEmails() below — the same
// e-mails you set in NEXT_PUBLIC_SUPERADMIN_EMAILS on Vercel.
//
// Roles (staff/{uid}.role)
//  • admin      = Sales Person: shared sample catalogue (edit only own samples),
//                 ONLY orders credited to them (status / trash only), own profile.
//  • subadmin   = admin + exactly the powers the Super Admin ticked in
//                 staff/{uid}.permissions (see lib/permissions.ts for the keys).
//  • superadmin = everything.
//  Customers (not signed in): read one design, the sharing Sales Person's public
//  name/WhatsApp, and create an order. Nothing else.

service cloud.firestore {
  match /databases/{database}/documents {

    function superEmails() {
      return ['YOUR_SUPERADMIN_EMAIL@gmail.com'];
    }

    function signedIn() { return request.auth != null; }
    function staffPath() { return /databases/$(database)/documents/staff/$(request.auth.uid); }
    function me() { return get(staffPath()).data; }
    function isStaff() {
      return signedIn() && exists(staffPath()) && me().get('active', true) != false;
    }
    function isBootstrapSuper() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() in superEmails();
    }
    function isSuper() {
      return isBootstrapSuper() || (isStaff() && me().get('role', 'admin') == 'superadmin');
    }
    function isAdmin() { return isStaff() && me().get('role', 'admin') == 'admin'; }
    function isSub() { return isStaff() && me().get('role', 'admin') == 'subadmin'; }
    // a power ticked by the Super Admin for this Sub Admin (Super Admin has all)
    function can(p) {
      return isSuper() || (isSub() && me().get('permissions', {}).get(p, false) == true);
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function validCategory(c) {
      return c in ['tyohaar', 'rozana', 'maharani', 'shudh'];
    }
    function activePublicStaff(uid) {
      return exists(/databases/$(database)/documents/publicStaff/$(uid))
        && get(/databases/$(database)/documents/publicStaff/$(uid)).data.active != false;
    }
    function staffRole(uid) {
      return get(/databases/$(database)/documents/staff/$(uid)).data.get('role', 'admin');
    }

    // ---------------------------------------------------------------- samples
    // Shared catalogue: anyone can view a design (customer links).
    match /samples/{id} {
      allow read: if true;
      // Admins add as themselves. A Sub Admin with "Add samples for another Admin"
      // may put a sample in another active team member's name.
      allow create: if (isAdmin() || can('addSamples'))
                    && validCategory(request.resource.data.category)
                    && request.resource.data.get('addedByUid', request.auth.uid) == request.auth.uid
                    && (request.resource.data.createdByUid == request.auth.uid
                        || (can('addForOthers') && activePublicStaff(request.resource.data.createdByUid)));
      allow update: if can('editAllSamples')
                    || (isStaff()
                        && resource.data.createdByUid == request.auth.uid
                        && request.resource.data.createdByUid == resource.data.createdByUid
                        && request.resource.data.get('createdByName', '') == resource.data.get('createdByName', ''));
      allow delete: if can('deleteSamples');
    }

    // ---------------------------------------------------------------- orders
    match /orders/{id} {
      // Customers create orders from a design link. The Sales Person must be a real,
      // active team member (or empty for links without a Sales Person).
      allow create: if request.resource.data.totalQuantity is number
                    && request.resource.data.totalQuantity > 0
                    && request.resource.data.firmName is string
                    && request.resource.data.mobile is string
                    && request.resource.data.get('status', 'Pending') == 'Pending'
                    && request.resource.data.get('isTrashed', false) == false
                    && (request.resource.data.get('salesPersonUid', '') == ''
                        || activePublicStaff(request.resource.data.salesPersonUid));

      // Admins see ONLY their own orders. Super Admin, and Sub Admins with the power, see all.
      allow read: if can('viewAllOrders')
                  || (isStaff() && resource.data.get('salesPersonUid', '') == request.auth.uid);

      // Status / trash: own orders, or everyone's with "Change status of all orders".
      // Credit (Sales Person) only with "Change Sales Person credit". Amounts never.
      allow update: if isSuper()
                    || (isStaff()
                        && resource.data.get('salesPersonUid', '') == request.auth.uid
                        && onlyChanges(['status', 'isTrashed']))
                    || (can('viewAllOrders') && can('manageAllOrders') && onlyChanges(['status', 'isTrashed']))
                    || (can('viewAllOrders') && can('reassignOrders')
                        && onlyChanges(['salesPersonUid', 'salesPersonName', 'salesPerson'])
                        && (request.resource.data.salesPersonUid == '' || activePublicStaff(request.resource.data.salesPersonUid)));
      allow delete: if can('viewAllOrders') && can('deleteOrders');
    }

    // Order number counter: may only ever go up by exactly one.
    match /counters/{id} {
      allow read: if true;
      allow create: if request.resource.data.currentSeq == 1;
      allow update: if request.resource.data.currentSeq == resource.data.currentSeq + 1;
      allow delete: if false;
    }

    // Company details shown on customer page & invoices.
    match /settings/{id} {
      allow read: if true;
      // settings/leads (who receives new leads) may also be changed by lead managers
      allow write: if can('settings') || (id == 'leads' && can('manageLeads'));
    }

    // Private configuration (WhatsApp bot on/off, test numbers). The webhook reads it with admin access.
    match /config/{id} {
      allow read, write: if can('settings');
    }
    // waSessions, waInbound: server only (no client access).

    // ---------------------------------------------------------------- leads
    // Enquiries (website call-back, WhatsApp, Instagram, Facebook, added by team).
    match /leads/{id} {
      // Customers: a call-back request. It may only be given to the Sales Person behind the link.
      allow create: if (request.resource.data.source == 'website'
                    && request.resource.data.status == 'new'
                    && request.resource.data.phone is string && request.resource.data.phone.size() <= 15
                    && request.resource.data.name is string && request.resource.data.name.size() <= 80
                    && request.resource.data.get('message', '').size() <= 500
                    && (request.resource.data.assignedUid == ''
                        || activePublicStaff(request.resource.data.assignedUid))
                    && !('createdByUid' in request.resource.data))
                    // Team: add leads by hand (Admins only for themselves)
                    || (isStaff()
                        && request.resource.data.createdByUid == request.auth.uid
                        && (can('manageLeads') || request.resource.data.assignedUid == request.auth.uid));
      // Admins see only leads given to them; lead managers see all.
      allow read: if can('manageLeads') || (isStaff() && resource.data.assignedUid == request.auth.uid);
      // Admins update their own leads (status, notes, follow-up) but cannot pass them on.
      allow update: if can('manageLeads')
                    || (isStaff()
                        && resource.data.assignedUid == request.auth.uid
                        && onlyChanges(['status', 'notes', 'followUpAt', 'updatedAt']));
      allow delete: if isSuper();
    }

    // ---------------------------------------------------------------- staff
    // Private team accounts, roles and powers.
    match /staff/{uid} {
      allow read: if isSuper() || can('manageTeam') || (signedIn() && request.auth.uid == uid);
      // Super Admin creates any role. A Sub Admin with "Add / disable Admins" creates Admins only.
      allow create: if isSuper()
                    || (isBootstrapSuper() && request.auth.uid == uid && request.resource.data.role == 'superadmin')
                    || (can('manageTeam')
                        && request.resource.data.role == 'admin'
                        && !('permissions' in request.resource.data));
      allow update: if isSuper()
                    // own name & WhatsApp only — never own role or powers
                    || (isStaff() && request.auth.uid == uid && onlyChanges(['whatsappNumber', 'name', 'nameConfirmed']))
                    // Sub Admin with "Add / disable Admins": enable/disable & WhatsApp of plain Admins
                    || (can('manageTeam') && request.auth.uid != uid
                        && resource.data.get('role', 'admin') == 'admin'
                        && onlyChanges(['active', 'whatsappNumber']));
      allow delete: if isSuper();
    }

    // Public part of a team profile: name + WhatsApp number that customer
    // order links open. Single document lookups are public; listing is staff-only.
    match /publicStaff/{uid} {
      allow get: if true;
      allow list: if isStaff();
      allow create, update: if isSuper()
                    || (isStaff()
                        && request.auth.uid == uid
                        && request.resource.data.uid == uid
                        && request.resource.data.name == me().name
                        && request.resource.data.active == true)
                    || (can('manageTeam') && request.auth.uid != uid
                        && request.resource.data.uid == uid
                        && staffRole(uid) == 'admin');
      allow delete: if isSuper();
    }
  }
}
